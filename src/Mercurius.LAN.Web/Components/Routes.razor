@using Mercurius.LAN.Web.Components.Shared

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized Context="authState">
                @if(authState.User.Identity?.IsAuthenticated == true)
                {
                    <LayoutView Layout="typeof(Layout.MainLayout)">
                        <PageTitle>Forbidden</PageTitle>
                        <StatusPage Eyebrow="System" Title="Forbidden" Message="You do not have permission to access this page." PrimaryHref="/" PrimaryLabel="Back Home" SecondaryHref="/tournaments" SecondaryLabel="Browse Tournaments" />
                    </LayoutView>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <AuthStatusToast />
        <ProfileRedirect RouteData="routeData" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <PageTitle>Not Found</PageTitle>
            <StatusPage Eyebrow="System" Title="Page Not Found" Message="The page you requested does not exist or has moved." PrimaryHref="/" PrimaryLabel="Back Home" SecondaryHref="/tournaments" SecondaryLabel="Browse Tournaments" />
        </LayoutView>
    </NotFound>
</Router>
