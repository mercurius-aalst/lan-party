@using Microsoft.AspNetCore.Components.Authorization
@using Refit

<!DOCTYPE html>
<html lang="en-US">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        (() => {
            const storageKey = "mercurius-lan-theme";
            const languageStorageKey = "mercurius-lan-language";
            const languageCookieName = "mercurius-lan-language";
            const supportedLanguages = new Set(["en-US", "nl-BE"]);
            const isTheme = value => value === "light" || value === "dark";
            const getSystemTheme = () => window.matchMedia?.("(prefers-color-scheme: dark)")?.matches ?? false;
            const getStoredTheme = () => {
                try {
                    return localStorage.getItem(storageKey);
                }
                catch {
                    return null;
                }
            };
            const applyTheme = preference => {
                const theme = isTheme(preference)
                    ? preference
                    : (getSystemTheme() ? "dark" : "light");
                document.documentElement.dataset.theme = theme;
                document.documentElement.style.colorScheme = theme;
                return theme;
            };

            applyTheme(getStoredTheme());
            window.lanTheme = {
                getStored: getStoredTheme,
                getSystem: getSystemTheme,
                apply: applyTheme,
                set: preference => {
                    try {
                        localStorage.setItem(storageKey, preference);
                    }
                    catch {
                        // Continue using the in-memory theme when storage is unavailable.
                    }

                    applyTheme(preference);
                }
            };

            const normalizeLanguage = value => supportedLanguages.has(value) ? value : "en-US";
            const getStoredLanguage = () => {
                try {
                    return normalizeLanguage(localStorage.getItem(languageStorageKey));
                }
                catch {
                    return "en-US";
                }
            };
            const applyLanguage = language => {
                const normalizedLanguage = normalizeLanguage(language);
                document.documentElement.lang = normalizedLanguage;
                return normalizedLanguage;
            };
            const syncLanguageCookie = language => {
                const normalizedLanguage = normalizeLanguage(language);
                try {
                    document.cookie = `${languageCookieName}=${encodeURIComponent(normalizedLanguage)}; path=/; max-age=31536000; samesite=lax`;
                    return document.cookie
                        .split(";")
                        .some(cookie => cookie.trim() === `${languageCookieName}=${encodeURIComponent(normalizedLanguage)}`);
                }
                catch {
                    return false;
                }
            };

            applyLanguage(getStoredLanguage());
            window.lanLocalization = {
                getStored: getStoredLanguage,
                apply: applyLanguage,
                syncCookie: syncLanguageCookie,
                set: language => {
                    const normalizedLanguage = normalizeLanguage(language);
                    try {
                        localStorage.setItem(languageStorageKey, normalizedLanguage);
                    }
                    catch {
                        // Continue with the in-memory language when storage is unavailable.
                    }

                    const cookiePersisted = syncLanguageCookie(normalizedLanguage);
                    applyLanguage(normalizedLanguage);
                    return cookiePersisted;
                }
            };
        })();
    </script>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Mercurius.LAN.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["tailwind.css"]" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <ImportMap />
    <link rel="icon" type="image/svg" href="favicon.svg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>       
    <CascadingAuthenticationState>
        <Routes @rendermode="RenderModeForPage" />
    </CascadingAuthenticationState>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="/uiInteractions.js"></script>
    <script src="/app.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    private IComponentRenderMode? RenderModeForPage =>
       HttpContext.GetEndpoint()?.Metadata.GetMetadata<RenderModeAttribute>()?
           .Mode;

}
