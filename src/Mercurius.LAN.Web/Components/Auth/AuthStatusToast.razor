@inject NavigationManager NavigationManager
@inject IToastService ToastService

@code {
    private string? _lastHandledStatus;

    protected override void OnAfterRender(bool firstRender)
    {
        var loginStatus = GetLoginStatus();
        if(string.IsNullOrWhiteSpace(loginStatus) || string.Equals(loginStatus, _lastHandledStatus, StringComparison.OrdinalIgnoreCase))
            return;

        _lastHandledStatus = loginStatus;

        if(string.Equals(loginStatus, "cancelled", StringComparison.OrdinalIgnoreCase))
        {
            ToastService.ShowInfo("Login was cancelled.");
        }
        else if(string.Equals(loginStatus, "failed", StringComparison.OrdinalIgnoreCase))
        {
            ToastService.ShowError("Login failed. Please try again.");
        }

        var cleanUri = RemoveLoginQueryParameter();
        NavigationManager.NavigateTo(cleanUri, replace: true);
    }

    private string? GetLoginStatus()
    {
        var currentUri = new Uri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(currentUri.Query);

        return query.TryGetValue("login", out var loginValues)
            ? loginValues.ToString()
            : null;
    }

    private string RemoveLoginQueryParameter()
    {
        var currentUri = new Uri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(currentUri.Query)
            .Where(entry => !string.Equals(entry.Key, "login", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(entry => entry.Key, entry => (string?)entry.Value.ToString());

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(currentUri.GetLeftPart(UriPartial.Path), query);
    }
}
