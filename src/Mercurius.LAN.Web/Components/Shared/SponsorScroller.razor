@if(Sponsors.Count > 0)
{
    <div class="sponsor-scroller" aria-label="@AriaLabel">
        <div class="sponsor-scroller__viewport">
            <div class="sponsor-scroller__track">
                @for(var loopIndex = 0; loopIndex < LoopCount; loopIndex++)
                {
                    var isPrimaryLoop = loopIndex == 0;

                    <div class="sponsor-scroller__loop" aria-hidden="@(!isPrimaryLoop)">
                        @foreach(var sponsor in Sponsors)
                        {
                            <a class="sponsor-scroller__logo"
                               href="@sponsor.InfoUrl"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="@(isPrimaryLoop ? $"Visit {sponsor.Name}" : null)"
                               tabindex="@(isPrimaryLoop ? null : "-1")">
                                <img src="@sponsor.LogoUrl" alt="@(isPrimaryLoop ? $"{sponsor.Name} logo" : string.Empty)" />
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
