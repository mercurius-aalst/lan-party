@using Blazored.Toast.Configuration

@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="layout-shell flex min-h-screen flex-col">
    <header class="brand-header sticky top-0 z-[1100]">
        <div class="brand-header-inner brand-container flex min-h-[5.5rem] items-center justify-between gap-4">
            <a class="brand-logo-link inline-flex shrink-0 items-center" href="/" aria-label="Mercurius LAN home">
                <img src="/img/lan_logo_wide_dark.svg" alt="Mercurius LAN" class="brand-logo-image" />
            </a>

            <button class="menu-toggle @(_sidebarOpen ? "open" : null)" @onclick="ToggleSidebar" aria-label="Toggle navigation">
                <span class="menu-toggle-inner">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </span>
            </button>

            <div class="brand-nav-panel flex flex-1 items-center justify-end @(_sidebarOpen ? "open" : null)">
                <NavMenu OnNavigationSelected="OnNavigationSelected" />
            </div>
        </div>
    </header>

    @if(_sidebarOpen)
    {
        <button type="button" class="brand-nav-backdrop" @onclick="HandleOutsideClick" aria-label="Close navigation"></button>
    }

    <main class="brand-main flex-1 @(IsHomePage ? "brand-main--home" : null)">
        <div class="brand-main-content brand-container">
            @Body
        </div>
    </main>

    <footer class="footer">
        <div class="brand-container footer-grid grid gap-7 lg:grid-cols-2 xl:[grid-template-columns:1.25fr_repeat(3,minmax(0,1fr))]">
            <section class="footer-brand">
                <div class="footer-logo-panel">
                    <img src="/img/lan_logo_wide_light.svg" alt="Mercurius LAN" class="footer-logo-image" />
                </div>
                <p>Mercurius LAN brings students together for tournaments, BYOC setups, and a full weekend of competitive play.</p>
            </section>

            <nav class="footer-column" aria-label="Quick links">
                <h3>Quick Links</h3>
                <a href="/">Home</a>
                <a href="/games">Tournaments</a>
                <a href="/sponsors">Sponsors</a>
                <a href="/info">Info</a>
                <a href="/privacy-policy">Privacy Policy</a>
            </nav>

            <section class="footer-column">
                <h3>Event Info</h3>
                <p>Student community. Compete. Connect.</p>
                <p>Offline mock mode is available for local UI validation.</p>
            </section>

            <section class="footer-column">
                <h3>Explore</h3>
                <a href="/info#where">When &amp; Where</a>
                <a href="/info#tickets">Tickets</a>
                <a href="/info#catering">Catering</a>
                <a href="/info#contact-info">Contact</a>
            </section>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<BlazoredToasts Position=ToastPosition.BottomRight />
