@rendermode InteractiveServer

@if(_isUserMenuVisible || _isDropdownVisible)
{
    <button type="button" class="nav-overlay" @onclick="HandleOutsideClick" aria-label="Close menus"></button>
}

<div class="brand-nav-shell">
    <nav class="brand-nav-links" aria-label="Primary">
        <NavLink href="/" Match="NavLinkMatch.All" class="brand-nav-link" ActiveClass="brand-nav-link--active" @onclick="HandleNavigationClicked">
            Home
        </NavLink>
        <NavLink href="games" Match="NavLinkMatch.All" class="brand-nav-link" ActiveClass="brand-nav-link--active" @onclick="HandleNavigationClicked">
            Games
        </NavLink>        
        <NavLink href="sponsors" Match="NavLinkMatch.All" class="brand-nav-link" ActiveClass="brand-nav-link--active" @onclick="HandleNavigationClicked">
        Sponsors
    </NavLink>
        <a href="/#tickets" class="brand-nav-link" @onclick="HandleNavigationClicked">Tickets</a>
        <a href="/#contact" class="brand-nav-link" @onclick="HandleNavigationClicked">Contact</a>
    </nav>

    <div class="brand-nav-actions">
        <AuthorizeView Roles="admin">
            <Authorized>
                <div class="nav-menu-group" @onclick:stopPropagation="true">
                    <button type="button" class="brand-utility-button" @onclick="ToggleDropdown">Admin</button>
                    @if(_isDropdownVisible)
                    {
                        <div class="dropdown-menu-custom" @onclick:stopPropagation="true">
                            <a class="dropdown-item" href="/admin/teams" @onclick="CloseDropdown">Teams</a>
                            <a class="dropdown-item" href="/admin/sponsors" @onclick="CloseDropdown">Sponsors</a>
                        </div>
                    }
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized Context="authState">
                <div class="nav-menu-group" @onclick:stopPropagation="true">
                    <button type="button" class="brand-utility-button user-button" @onclick="ToggleUserMenu">
                        <span class="user-icon bi bi-person-circle"></span>
                        <span>@GetDisplayName(authState.User)</span>
                    </button>
                    @if(_isUserMenuVisible)
                    {
                        <div class="dropdown-menu-custom" @onclick:stopPropagation="true">
                            <a class="dropdown-item" href="/profile" @onclick="CloseDropdown">Profile</a>
                            <button type="button" class="dropdown-item dropdown-button" @onclick="Logout">Logout</button>
                        </div>
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="brand-auth-actions">
                    <button type="button" class="brand-utility-button" @onclick="BeginLogin">Login</button>
                    @if(IsMockBackendEnabled)
                    {
                        <a href="@MockAdminLoginHref" class="brand-dev-link" @onclick="HandleNavigationClicked">Mock Admin</a>
                    }
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <a href="/#tickets" class="button-primary brand-ticket-cta" @onclick="HandleNavigationClicked">
            Get Tickets
        </a>
    </div>
</div>
