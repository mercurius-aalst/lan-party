@rendermode InteractiveServer

@if(ShouldShowInteractionOverlay)
{
    <button type="button" class="nav-overlay" @onclick="HandleOutsideClick" aria-label="Close menus"></button>
}

<div class="brand-nav-shell flex w-full flex-col gap-4 md:flex-row md:items-center md:justify-between" @onclick="HandleNavShellClick">
    <nav class="brand-nav-links flex flex-col items-stretch gap-3 md:flex-1 md:flex-row md:items-center md:justify-center md:gap-5" aria-label="Primary">
        <NavLink href="/" Match="NavLinkMatch.All" class="brand-nav-link text-center md:text-left" ActiveClass="brand-nav-link--active" @onclick="HandleNavigationClicked">
            Home
        </NavLink>
        <NavLink href="/tournaments" Match="NavLinkMatch.Prefix" class="brand-nav-link text-center md:text-left" ActiveClass="brand-nav-link--active" @onclick="HandleNavigationClicked">
            Tournaments
        </NavLink>
        <NavLink href="/sponsors" Match="NavLinkMatch.All" class="brand-nav-link text-center md:text-left" ActiveClass="brand-nav-link--active" @onclick="HandleNavigationClicked">
            Sponsors
        </NavLink>
        <div class="nav-menu-group info-nav-group" @onclick:stopPropagation="true">
            <button type="button"
                    class="@GetInfoButtonClass()"
                    @onclick="ToggleInfoMenu"
                    aria-expanded="@GetAriaExpanded(_isInfoMenuVisible)"
                    aria-haspopup="true">
                Info
                <span class="bi bi-chevron-down info-nav-caret" aria-hidden="true"></span>
            </button>
            @if(_isInfoMenuVisible)
            {
                <div class="dropdown-menu-custom info-dropdown mt-2 flex min-w-full flex-col gap-1 md:mt-0 md:min-w-[13rem]" @onclick:stopPropagation="true">
                    <NavLink href="/info" Match="NavLinkMatch.All" class="dropdown-item" ActiveClass="dropdown-item--active" @onclick="HandleNavigationClicked">Overview</NavLink>
                    <a href="/info#packing" class="dropdown-item" @onclick="HandleNavigationClicked">What to bring</a>
                    <a href="/info#where" class="dropdown-item" @onclick="HandleNavigationClicked">When &amp; where</a>
                    <a href="/info#tickets" class="dropdown-item" @onclick="HandleNavigationClicked">Tickets</a>
                    <a href="/info#catering" class="dropdown-item" @onclick="HandleNavigationClicked">Catering</a>
                    <a href="/info#contact-info" class="dropdown-item" @onclick="HandleNavigationClicked">Contact</a>
                </div>
            }
        </div>
    </nav>

    <div id="@SearchContainerElementId" class="@GetSearchContainerClass()" @onclick:stopPropagation="true">
        <label class="visually-hidden" for="global-nav-search">Search users, teams, and tournaments</label>
        <div class="@GetSearchInputShellClass()">
            <span class="bi bi-search nav-search-icon" aria-hidden="true"></span>
            <input id="global-nav-search"
                   class="nav-search-input"
                   type="search"
                   placeholder="Search players, teams, tournaments"
                   value="@_searchQuery"
                   @oninput="HandleSearchInputAsync"
                   @onfocus="HandleSearchFocus"
                   @onkeydown="HandleSearchKeyDownAsync"
                   autocomplete="off"
                   spellcheck="false"
                   aria-label="Search players, teams, and tournaments"
                   aria-autocomplete="list"
                   aria-expanded="@GetAriaExpanded(_isSearchDropdownVisible)"
                   aria-controls="global-nav-search-results" />

            @if(!string.IsNullOrWhiteSpace(_searchQuery))
            {
                <button type="button" class="nav-search-clear-button" @onclick="ClearSearchInputAsync" aria-label="Clear search">
                    <span class="bi bi-x-lg" aria-hidden="true"></span>
                </button>
            }
        </div>

        @if(_isSearchDropdownVisible)
        {
            <div id="global-nav-search-results" class="nav-search-dropdown" role="listbox" aria-label="Search results" @onclick:stopPropagation="true">
                @if(_isSearchLoading)
                {
                    <div class="nav-search-state" aria-live="polite">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        <span>Searching...</span>
                    </div>
                }
                else if(_hasSearchError)
                {
                    <div class="nav-search-state nav-search-state--error" aria-live="polite">
                        Search is unavailable right now.
                    </div>
                }
                else if(!HasSearchResults)
                {
                    <div class="nav-search-state" aria-live="polite">
                        No matches found.
                    </div>
                }
                else
                {
                    @for(var index = 0; index < _searchResults.Count; index++)
                    {
                        var result = _searchResults[index];
                        <GlobalSearchResultItem Result="result"
                                                IsActive="@(_highlightedSearchIndex == index)"
                                                Selected="SelectSearchResultAsync"
                                                Hovered="@(() => SetSearchHighlight(index))" />
                    }
                }
            </div>
        }
    </div>

    <div class="brand-nav-actions flex flex-col items-stretch gap-3 md:flex-row md:items-center md:justify-end">
        <AuthorizeView Roles="admin">
            <Authorized>
                <div class="nav-menu-group" @onclick:stopPropagation="true">
                    <button type="button"
                            class="@GetAdminButtonClass()"
                            @onclick="ToggleDropdown"
                            aria-expanded="@GetAriaExpanded(_isDropdownVisible)">
                        Admin
                    </button>
                    @if(_isDropdownVisible)
                    {
                        <div class="dropdown-menu-custom mt-2 flex min-w-full flex-col gap-1 md:mt-0 md:min-w-[12rem]" @onclick:stopPropagation="true">
                            <NavLink href="/admin/sponsors" Match="NavLinkMatch.All" class="dropdown-item" ActiveClass="dropdown-item--active" @onclick="HandleNavigationClicked">Sponsors</NavLink>
                        </div>
                    }
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized Context="authState">
                <div id="@AccountMenuContainerElementId" class="nav-menu-group nav-user-widget" @onclick:stopPropagation="true">
                    <div class="nav-user-widget-controls">
                        <button type="button"
                                class="@GetUserButtonClass()"
                                @onclick="ToggleUserMenu"
                                aria-expanded="@GetAriaExpanded(_isUserMenuVisible)"
                                aria-label="@GetUserMenuAriaLabel(authState.User)">
                            <span class="user-icon bi bi-person-circle" aria-hidden="true"></span>
                            <span>@GetDisplayName(authState.User)</span>
                        </button>
                        <button type="button"
                                class="@GetNotificationButtonClass()"
                                @onclick="ToggleNotificationMenu"
                                aria-expanded="@GetAriaExpanded(_isNotificationMenuVisible)"
                                aria-label="@GetNotificationAriaLabel()">
                            <span class="bi bi-bell-fill" aria-hidden="true"></span>
                            @if(NotificationCount > 0)
                            {
                                <span class="nav-notification-badge">@NotificationCount</span>
                            }
                        </button>
                    </div>
                    @if(_isUserMenuVisible)
                    {
                        <div class="dropdown-menu-custom nav-user-menu mt-2 flex min-w-full flex-col gap-1 md:mt-0" @onclick:stopPropagation="true">
                            <NavLink href="/profile" Match="NavLinkMatch.All" class="dropdown-item" ActiveClass="dropdown-item--active" @onclick="HandleNavigationClicked">Profile</NavLink>
                            <NavLink href="/teams/manage" Match="NavLinkMatch.All" class="dropdown-item" ActiveClass="dropdown-item--active" @onclick="HandleNavigationClicked">Teams</NavLink>
                            <button type="button" class="dropdown-item dropdown-button" @onclick="Logout">Logout</button>
                        </div>
                    }
                    @if(_isNotificationMenuVisible)
                    {
                        <div class="dropdown-menu-custom nav-notification-dropdown mt-2 flex min-w-full flex-col gap-1 md:mt-0" @onclick:stopPropagation="true">
                            <div class="nav-notification-menu">
                                <div class="nav-notification-header">
                                    <strong>Notifications</strong>
                                    @if(NotificationCount > 0)
                                    {
                                        <button type="button" @onclick="MarkNotificationsReadAsync">Mark read</button>
                                    }
                                </div>
                                @if(NotificationService.Notifications.Count == 0)
                                {
                                    <div class="nav-notification-empty">No notifications.</div>
                                }
                                else
                                {
                                    @foreach(var notification in NotificationService.Notifications)
                                    {
                                        <div class="@GetNotificationItemClass(notification)">
                                            <a href="@notification.Href" @onclick="HandleNavigationClicked">
                                                <span>@notification.Title</span>
                                                <small>@notification.Message</small>
                                            </a>
                                            <div class="nav-notification-actions">
                                                @if(notification.InviteId.HasValue)
                                                {
                                                    <button type="button" class="nav-notification-action nav-notification-action--accept" @onclick="() => RespondToInviteNotificationAsync(notification.InviteId.Value, true)" aria-label="Accept invitation">
                                                        <span class="bi bi-check-lg" aria-hidden="true"></span>
                                                    </button>
                                                    <button type="button" class="nav-notification-action nav-notification-action--decline" @onclick="() => RespondToInviteNotificationAsync(notification.InviteId.Value, false)" aria-label="Decline invitation">
                                                        <span class="bi bi-x-lg" aria-hidden="true"></span>
                                                    </button>
                                                }
                                                <button type="button" class="nav-notification-action" @onclick="() => DismissNotificationAsync(notification.Id)" aria-label="Dismiss notification">
                                                    <span class="bi bi-dash-lg" aria-hidden="true"></span>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="brand-auth-actions flex flex-col items-stretch gap-3 md:flex-row md:items-center">
                    <button type="button" class="brand-utility-button w-full justify-center md:w-auto" @onclick="BeginLogin">Login</button>
                    @if(IsMockBackendEnabled)
                    {
                        <a href="@MockAdminLoginHref" class="brand-dev-link inline-flex w-full items-center justify-center rounded-[12px] border border-[rgba(34,197,94,0.16)] px-4 py-3 text-center md:w-auto md:border-0 md:px-0 md:py-0" @onclick="HandleNavigationClicked">Mock Admin</a>
                    }
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <a href="/info#tickets" class="button-primary brand-ticket-cta w-full justify-center md:w-auto" @onclick="HandleNavigationClicked">
            Get Tickets
        </a>
    </div>
</div>
