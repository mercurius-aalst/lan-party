@page "/Error"
@using System.Diagnostics
@using Mercurius.LAN.Web.Components.Shared
@rendermode InteractiveServer

<PageTitle>Error</PageTitle>

<StatusPage Eyebrow="System" Title="Error" Message="An unexpected error occurred while processing your request." PrimaryHref="/" PrimaryLabel="Back Home" SecondaryHref="/games" SecondaryLabel="Browse Games">
    @if(ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@_requestId</code></p>
    }

    <p>Swapping to <strong>Development</strong> will show more detailed exception information for local debugging.</p>
    <p><strong>Do not enable Development in production.</strong> It can expose sensitive information to end users.</p>
</StatusPage>
