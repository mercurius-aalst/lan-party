@page "/Error"
@using System.Diagnostics
@using Mercurius.LAN.Web.Components.Shared
@rendermode InteractiveServer

<PageTitle>@Localization["common.error"]</PageTitle>

<StatusPage Eyebrow='@Localization["common.system"]' Title='@Localization["common.error"]' Message='@Localization["common.unexpectedError"]' PrimaryHref="/" PrimaryLabel='@Localization["common.backHome"]' SecondaryHref="/tournaments" SecondaryLabel='@Localization["common.browseTournaments"]'>
    @if(ShowRequestId)
    {
        <p><strong>@Localization["common.requestId"]</strong> <code>@_requestId</code></p>
    }

    <p>@Localization["common.developmentHint"]</p>
    <p><strong>@Localization["common.doNotEnableDevelopment"]</strong></p>
</StatusPage>
