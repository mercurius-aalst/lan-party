@page "/privacy-policy"

<PageTitle>@Localization["privacy.pageTitle"]</PageTitle>

<section class="privacy-page">
    <header class="privacy-hero brand-section">
        <span class="section-eyebrow">@Localization["General.Privacy.Legal"]</span>
        <h1>@Localization["General.Privacy.Title"]</h1>
        <p>@Localization["General.Privacy.Edition"]</p>
    </header>

    <article class="brand-card privacy-policy-container">
        <p><strong>@Localization["General.Privacy.EditionLabel"]</strong> 2025-2026</p>

        <h2>1. @Localization["General.Privacy.IntroductionHeading"]</h2>
        <p>@Localization["General.Privacy.IntroParagraph1"]</p>
        <p>@Localization["General.Privacy.IntroParagraph2"]</p>

        <h2>2. @Localization["General.Privacy.ControllerHeading"]</h2>
        <p>@Localization["General.Privacy.ControllerIntro"]</p>
        <ul>
            <li><strong>@Localization["General.Privacy.AssociationNameLabel"]</strong> Mercurius Aalst</li>
            <li><strong>@Localization["General.Privacy.ContactAddressLabel"]</strong> Welvaartstraat 32, 9300 Aalst</li>
            <li><strong>@Localization["General.Privacy.EmailLabel"]</strong> mercuriusaalst.studentenclub@gmail.com</li>
        </ul>

        <h2>3. @Localization["General.Privacy.DataCollectionHeading"]</h2>

        <h3>A. @Localization["General.Privacy.PresenceHeading"]</h3>
        <p>@Localization["General.Privacy.PresenceIntro"]</p>

        <ul class="data-list">
            <li>
                <span class="data-label">@Localization["General.Privacy.FirstName"]</span>
                <span class="data-meta"><span class="tag tag-req">@Localization["General.Privacy.Required"]</span> @Localization["General.Privacy.IdentificationInsurance"]</span>
            </li>
            <li>
                <span class="data-label">@Localization["General.Privacy.LastName"]</span>
                <span class="data-meta"><span class="tag tag-req">@Localization["General.Privacy.Required"]</span> @Localization["General.Privacy.IdentificationInsurance"]</span>
            </li>
            <li>
                <span class="data-label">@Localization["General.Privacy.Email"]</span>
                <span class="data-meta"><span class="tag tag-req">@Localization["General.Privacy.Required"]</span> @Localization["General.Privacy.UniqueIdentification"]</span>
            </li>
        </ul>

        <h3>B. @Localization["General.Privacy.ParticipationHeading"]</h3>
        <p>@Localization["General.Privacy.ParticipationIntro"]</p>

        <ul class="data-list">
            <li>
                <span class="data-label">@Localization["General.Privacy.Username"]</span>
                <span class="data-meta"><span class="tag tag-req">@Localization["General.Privacy.Required"]</span> @Localization["General.Privacy.PublicTournamentName"]</span>
            </li>
            <li>
                <span class="data-label">@Localization["General.Privacy.FirstName"]</span>
                <span class="data-meta"><span class="tag tag-req">@Localization["General.Privacy.Required"]</span> @Localization["General.Privacy.InternalControl"]</span>
            </li>
            <li>
                <span class="data-label">@Localization["General.Privacy.LastName"]</span>
                <span class="data-meta"><span class="tag tag-req">@Localization["General.Privacy.Required"]</span> @Localization["General.Privacy.InternalControl"]</span>
            </li>
            <li>
                <span class="data-label">@Localization["General.Privacy.Email"]</span>
                <span class="data-meta"><span class="tag tag-req">@Localization["General.Privacy.Required"]</span> @Localization["General.Privacy.TournamentCommunication"]</span>
            </li>
            <li>
                <span class="data-label">@Localization["General.Privacy.SteamId"]</span>
                <span class="data-meta"><span class="tag tag-opt">@Localization["General.Privacy.Optional"]</span> @Localization["General.Privacy.LinkedProfile"]</span>
            </li>
            <li>
                <span class="data-label">@Localization["General.Privacy.DiscordId"]</span>
                <span class="data-meta"><span class="tag tag-opt">@Localization["General.Privacy.Optional"]</span> @Localization["General.Privacy.LinkedProfile"]</span>
            </li>
            <li>
                <span class="data-label">@Localization["General.Privacy.RiotId"]</span>
                <span class="data-meta"><span class="tag tag-opt">@Localization["General.Privacy.Optional"]</span> @Localization["General.Privacy.LinkedProfile"]</span>
            </li>
        </ul>

        <h3>C. @Localization["General.Privacy.NetworkHeading"]</h3>
        <p>@Localization["General.Privacy.NetworkIntro"]</p>
        <ul class="data-list">
            <li>
                <span class="data-label">@Localization["General.Privacy.MacAddress"]</span>
                <span class="data-meta"><span class="tag tag-tech">@Localization["General.Privacy.Technical"]</span> @Localization["General.Privacy.TemporaryNetworkAccess"]</span>
            </li>
        </ul>
        <p><strong>@Localization["General.Privacy.ImportantLabel"]</strong> @Localization["General.Privacy.NetworkDataParagraph"] <a href="https://www.hogent.be/privacyverklaring-hogent/">@Localization["General.Privacy.HoGentPrivacyLink"]</a>.</p>

        <h2>4. @Localization["General.Privacy.PurposesHeading"]</h2>
        <ol>
            <li><strong>@Localization["General.Privacy.SecurityPurposeLabel"]</strong> @Localization["General.Privacy.SecurityPurposeBody"]</li>
            <li><strong>@Localization["General.Privacy.StatisticsPurposeLabel"]</strong> @Localization["General.Privacy.StatisticsPurposeBody"]</li>
            <li><strong>@Localization["General.Privacy.CompetitionPurposeLabel"]</strong> @Localization["General.Privacy.CompetitionPurposeBody"]</li>
            <li><strong>@Localization["General.Privacy.PublicPurposeLabel"]</strong> @Localization["General.Privacy.PublicPurposeBody"]</li>
        </ol>

        <h2>5. @Localization["General.Privacy.DisclosureHeading"]</h2>
        <div class="warning-box">
            <p><strong>@Localization["General.Privacy.NoticeLabel"]</strong> @Localization["General.Privacy.NoticeBody"]</p>
            <ul>
                <li><strong>@Localization["General.Privacy.PubliclyVisibleLabel"]</strong> @Localization["General.Privacy.PubliclyVisibleBody"]</li>
                <li><strong>@Localization["General.Privacy.NotPublicLabel"]</strong> @Localization["General.Privacy.NotPublicBody"]</li>
            </ul>
        </div>

        <h2>6. @Localization["General.Privacy.LegalBasisHeading"]</h2>
        <ul>
            <li><strong>@Localization["General.Privacy.LegitimateInterestLabel"]</strong> @Localization["General.Privacy.LegitimateInterestBody"]</li>
            <li><strong>@Localization["General.Privacy.ContractLabel"]</strong> @Localization["General.Privacy.ContractBody"]</li>
            <li><strong>@Localization["General.Privacy.ConsentLabel"]</strong> @Localization["General.Privacy.ConsentBody"]</li>
        </ul>

        <h2>7. @Localization["General.Privacy.SharingHeading"]</h2>
        <ul>
            <li><strong>@Localization["General.Privacy.PlatformLabel"]</strong> @Localization["General.Privacy.PlatformBody"]</li>
            <li><strong>@Localization["General.Privacy.SponsorsLabel"]</strong> @Localization["General.Privacy.SponsorsBody"]</li>
            <li><strong>@Localization["General.Privacy.InsurerLabel"]</strong> @Localization["General.Privacy.InsurerBody"]</li>
            <li><strong>@Localization["General.Privacy.HoGentLabel"]</strong> @Localization["General.Privacy.HoGentBody"]</li>
        </ul>

        <h2>8. @Localization["General.Privacy.RetentionHeading"]</h2>
        <p>@Localization["General.Privacy.RetentionIntro"]</p>
        <ul>
            <li><strong>@Localization["General.Privacy.PresenceRetentionLabel"]</strong> @Localization["General.Privacy.PresenceRetentionBody"]</li>
            <li><strong>@Localization["General.Privacy.ContactRetentionLabel"]</strong> @Localization["General.Privacy.ContactRetentionBody"]</li>
            <li><strong>@Localization["General.Privacy.HistoricalRetentionLabel"]</strong> @Localization["General.Privacy.HistoricalRetentionBody"]</li>
        </ul>

        <h2>9. @Localization["General.Privacy.RightsHeading"]</h2>
        <p>@Localization["General.Privacy.RightsBody"] <strong>mercuriusaalst.studentenclub@gmail.com</strong>.</p>
        <p><strong>@Localization["General.Privacy.RightsResponse"]</strong></p>
        <p>@Localization["General.Privacy.ComplaintsBody"] (<a href="https://www.gegevensbeschermingsautoriteit.be" target="_blank" rel="noopener noreferrer">www.gegevensbeschermingsautoriteit.be</a>).</p>
    </article>
</section>
