@page "/admin/sponsors"
@attribute [Authorize(Roles = "admin")]
@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.DTOs.Sponsors
@using Mercurius.LAN.Web.Extensions
@using Mercurius.LAN.Web.Models.Sponsors
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer

<PageTitle>@Localization["Admin.pageTitle"]</PageTitle>

@if(_isLoading)
{
    <LoadingScreen Message='@Localization["Admin.loadingSponsors"]' />
}
else
{
    <section class="sponsor-admin-page">
        <div class="sponsor-admin-layout">
            <section class="brand-card sponsor-admin-form-card">
                <div class="sponsor-admin-card-header">
                    <div>
                        <h2>@Localization["Admin.manageSponsors"]</h2>
                    </div>
                </div>

                <div class="search-bar-container sponsor-admin-search-container">
                    <CustomAutocomplete @ref="_autoCompleteComponent" TItem="SponsorManagementDTO" Items="_displaySponsors" ItemLabel="sponsor => sponsor.Name" OnSelected="OnSponsorSelected" Placeholder='@Localization["Admin.searchSponsors"]' />
                </div>

                <EditForm EditContext="_editContext" OnValidSubmit="HandleSubmit">
                    <div class="sponsor-admin-form-grid">
                        <div class="form-group">
                            <label for="name">@Localization["Admin.name"]</label>
                            <InputText id="name" class="form-control" @bind-Value="_selectedSponsor.Name" />
                            <ValidationMessage For="@(() => _selectedSponsor.Name)" />
                        </div>

                        <div class="form-group">
                            <label for="infoUrl">@Localization["Admin.infoUrl"]</label>
                            <InputText id="infoUrl" class="form-control" @bind-Value="_selectedSponsor.InfoUrl" />
                            <ValidationMessage For="@(() => _selectedSponsor.InfoUrl)" />
                        </div>

                        <div class="form-group">
                            <label for="sponsorTier">@Localization["Admin.sponsorTier"]</label>
                            <InputSelect id="sponsorTier" class="form-control" @bind-Value="_selectedSponsor.SponsorTier">
                                @foreach(var tier in Enum.GetValues<SponsorTier>())
                                {
                                    <option value="@tier">@GetTierLabel(tier)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _selectedSponsor.SponsorTier)" />
                        </div>

                        <div class="form-group">
                            <label for="sponsorLogo">@Localization["Admin.logo"]</label>
                            <CustomInputFile @ref="_imageInputRef" id="sponsorLogo" LabelText='@Localization["Admin.chooseLogo"]' @bind-Value="_selectedSponsor.Logo" />
                            <ValidationMessage For="@(() => _selectedSponsor.Logo)" />
                        </div>

                        <div class="form-group sponsor-admin-description-field">
                            <label for="description">@Localization["Admin.description"]</label>
                            <InputTextArea id="description" class="form-control" @bind-Value="_selectedSponsor.Description" />
                            <ValidationMessage For="@(() => _selectedSponsor.Description)" />
                        </div>
                    </div>

                    <div class="form-actions">
                        <div class="form-actions-section">
                            <button type="submit" class="btn btn-primary">@(_isCreateMode ? Localization["Admin.createSponsor"] : Localization["Admin.updateSponsor"])</button>
                        </div>
                        <div class="form-actions-section">
                            @if(!_isCreateMode)
                            {
                                <button type="button" class="btn btn-danger" @onclick="DeleteSponsor">@Localization["Admin.deleteSponsor"]</button>
                            }
                            <button type="button" class="btn btn-secondary" @onclick="ClearForm">@Localization["Admin.clear"]</button>
                        </div>
                    </div>
                </EditForm>
            </section>

            <aside class="sponsor-admin-sidebar">
                <section class="brand-card sponsor-admin-side-card">
                    <h2>@Localization["Admin.overview"]</h2>
                    <ul class="sponsor-admin-points">
                        <li>@(_sponsors.Count == 1 ? Localization.Get("Admin.sponsorCountOne", _sponsors.Count) : Localization.Get("Admin.sponsorCountMany", _sponsors.Count))</li>
                        <li>@(_isCreateMode ? Localization["Admin.addingSponsor"] : Localization.Get("Admin.editingSponsor", _selectedSponsor.Name))</li>
                        <li>@Localization["Admin.placement"]</li>
                    </ul>
                </section>
            </aside>
        </div>
    </section>
}
