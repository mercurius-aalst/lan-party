@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.DTOs.Games
@using Mercurius.LAN.Web.Extensions
@using Mercurius.LAN.Web.Models.Games
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer

<div class="game-overview-container">
    <div class="overview-header-row">
        <div>
            <span class="section-eyebrow">Overview</span>
            <h2 class="game-overview-header">Tournament overview</h2>
            <p>Core format, status, scheduling, and registration details for this tournament.</p>
        </div>

        @if(!_isEditMode && Game.Status == GameStatus.Scheduled)
        {
            <AuthorizeView Roles="admin">
                <Authorized>
                    <button type="button" class="btn btn-primary" @onclick="EnableEditMode">Edit</button>
                </Authorized>
            </AuthorizeView>
        }
    </div>

    @if(!_isEditMode)
    {
        <div class="overview-grid">
            <section class="brand-card overview-card">
                <h3>Competition setup</h3>
                <dl class="overview-list">
                    <div>
                        <dt>Status</dt>
                        <dd><span class="game-status @Game.Status.GetStatusClass()">@Game.Status.GetStatusLabel()</span></dd>
                    </div>
                    <div>
                        <dt>Bracket</dt>
                        <dd>@Game.BracketType.GetLabel()</dd>
                    </div>
                    <div>
                        <dt>Mode</dt>
                        <dd>@Game.ParticipationMode.GetLabel()</dd>
                    </div>
                    <div>
                        <dt>Format</dt>
                        <dd>@Game.Format.GetLabel()</dd>
                    </div>
                </dl>
            </section>

            <section class="brand-card overview-card">
                <h3>Schedule & registration</h3>
                <dl class="overview-list">
                    <div>
                        <dt>Start time</dt>
                        <dd>@GetPlannedStartLabel()</dd>
                    </div>
                    <div>
                        <dt>Estimated end</dt>
                        <dd>@GetEstimatedEndLabel()</dd>
                    </div>
                    <div>
                        <dt>Finals</dt>
                        <dd>@Game.FinalsFormat.GetLabel()</dd>
                    </div>
                    <div>
                        <dt>Registration</dt>
                        <dd>@GetRegistrationStateLabel()</dd>
                    </div>
                </dl>
            </section>
        </div>
    }
    else
    {
        <AuthorizeView Roles="admin">
            <Authorized Context="adminContext">
                <EditForm EditContext="_editContext" OnValidSubmit="SubmitEditAsync">
                    <DataAnnotationsValidator />
                    <div class="brand-card overview-edit-card">
                        <div class="form-group">
                            <label for="name">Name</label>
                            <InputText id="name" class="form-control" @bind-Value="_editGame.Name" />
                            <ValidationMessage For="@(() => _editGame.Name)" />
                        </div>

                        <div class="form-group">
                            <label for="bracketType">Bracket Type</label>
                            <InputSelect id="bracketType" class="form-control" @bind-Value="_editGame.BracketType">
                                @foreach(var type in SupportedBracketTypes)
                                {
                                    <option value="@type">@type.GetLabel()</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _editGame.BracketType)" />
                        </div>

                        <div class="form-group">
                            <label for="participationMode">Participation Mode</label>
                            <InputSelect id="participationMode" class="form-control" @bind-Value="_editGame.ParticipationMode">
                                @foreach(ParticipationMode type in Enum.GetValues(typeof(ParticipationMode)))
                                {
                                    <option value="@type">@type.GetLabel()</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _editGame.ParticipationMode)" />
                        </div>

                        <div class="form-group">
                            <label for="format">Match Format</label>
                            <InputSelect id="format" class="form-control" @bind-Value="_editGame.Format">
                                @foreach(GameFormat type in Enum.GetValues(typeof(GameFormat)))
                                {
                                    <option value="@type">@type.GetLabel()</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _editGame.Format)" />
                        </div>

                        <div class="form-group">
                            <label for="finalsFormat">Finals Format</label>
                            <InputSelect id="finalsFormat" class="form-control" @bind-Value="_editGame.FinalsFormat">
                                @foreach(GameFormat type in Enum.GetValues(typeof(GameFormat)))
                                {
                                    <option value="@type">@type.GetLabel()</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _editGame.FinalsFormat)" />
                        </div>
                        <div class="overview-edit-schedule-fields">
                            <div class="form-group">
                                <label for="plannedStartTime">Planned start time</label>
                                <input id="plannedStartTime" type="datetime-local" class="form-control" @bind="_editGame.PlannedStartTime" @bind:format="yyyy-MM-ddTHH:mm" />
                                <ValidationMessage For="@(() => _editGame.PlannedStartTime)" />
                            </div>

                            <div class="overview-edit-duration-row">
                                <div class="form-group">
                                    <label for="averageGameDuration">Average game duration (minutes)</label>
                                    <InputNumber id="averageGameDuration" class="form-control" @bind-Value="_editGame.AverageGameDurationMinutes" />
                                    <ValidationMessage For="@(() => _editGame.AverageGameDurationMinutes)" />
                                </div>

                                <div class="form-group">
                                    <label for="roundBreakDuration">Round break (minutes)</label>
                                    <InputNumber id="roundBreakDuration" class="form-control" @bind-Value="_editGame.RoundBreakDurationMinutes" />
                                    <ValidationMessage For="@(() => _editGame.RoundBreakDurationMinutes)" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="registrationUrl">Registration form url</label>
                            <InputText id="registrationUrl" class="form-control" @bind-Value="_editGame.RegisterFormUrl" />
                            <ValidationMessage For="@(() => _editGame.RegisterFormUrl)" />
                        </div>
                        <div class="form-group">
                            <label for="gameImage">Game Image</label>
                            <CustomInputFile @ref="_imageInputRef" id="gameImage" @bind-Value="_editGame.Image" />
                            <ValidationMessage For="@(() => _editGame.Image)" />
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="button" class="btn btn-secondary" @onclick="CancelEditMode">Cancel</button>
                        </div>
                    </div>
                </EditForm>
            </Authorized>
        </AuthorizeView>
    }
</div>
