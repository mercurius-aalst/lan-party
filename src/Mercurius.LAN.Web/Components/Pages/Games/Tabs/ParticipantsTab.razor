@rendermode InteractiveServer
@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.Models.Games
@using Microsoft.AspNetCore.Components.Authorization

<div class="participants-tab-shell">
    <div class="participants-tab-header">
        <div>
            <span class="section-eyebrow">Participants</span>
            <h2>Registered @GetParticipantsHeading()</h2>
            <p>@_participants.Count currently registered for this tournament.</p>
        </div>
    </div>

    <div class="participants-overview-grid">
        <AuthorizeView Roles="admin">
            <Authorized>
                @if(Game.Status == GameStatus.Scheduled)
                {
                    <button type="button" class="participant-overview-card add-participants-card" @onclick="DisplayAddParticipantsPopupAsync">
                        <div class="participant-avatar add-avatar">+</div>
                        <div class="participant-overview-name">Add @GetParticipantLabel()</div>
                    </button>
                }
            </Authorized>
        </AuthorizeView>
        @foreach(var participant in _participants)
        {
            <ParticipantCardComponent Participant="participant" OnParticipantSelected="ShowParticipantPopup" AllowDeleteFunction="@(Game.Status == GameStatus.Scheduled)" OnParticipantDeleted="UnregisterParticipantAsync" />
        }
    </div>
    @if(_selectedParticipant != null)
    {
        <div class="participants-modal-overlay" @onclick="ClosePopup">
            <div class="participants-modal-dialog participants-modal-dialog--detail" @onclick:stopPropagation>
                <button type="button" class="participants-modal-close" aria-label="Close participant details" @onclick="ClosePopup">&times;</button>
                <div class="participants-modal-header">
                    <span class="section-eyebrow">Participant</span>
                    <h3>@_selectedParticipant.DisplayName</h3>
                    <p>@GetParticipantModalSummary()</p>
                </div>
                <ParticipantComponent Participant="_selectedParticipant" ShowIdentityHeader="false" />
            </div>
        </div>
    }

    @if(_isAddParticipantsPopupVisible)
    {
        <div class="participants-modal-overlay" @onclick="HideAddParticipantsPopup">
            <div class="participants-modal-dialog participants-modal-dialog--picker" @onclick:stopPropagation>
                <button type="button" class="participants-modal-close" aria-label="Close add participants" @onclick="HideAddParticipantsPopup">&times;</button>
                <div class="participants-modal-header">
                    <span class="section-eyebrow">Admin</span>
                    <h3>Add @GetParticipantsHeading()</h3>
                    <p>Select from the available @GetParticipantLabel() that are not yet registered for this tournament.</p>
                </div>
                <div class="participants-overview-grid centered-grid">
                    @foreach(var participant in _availableParticipants)
                    {
                        <ParticipantCardComponent Participant="participant" OnParticipantSelected="AddParticipantAsync" />
                    }
                </div>
            </div>
        </div>
    }
</div>
