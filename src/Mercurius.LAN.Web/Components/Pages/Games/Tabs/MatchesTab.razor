@using Mercurius.LAN.Web.Components.Pages.Games.Matches.BracketView
@using Mercurius.LAN.Web.Models.Games
@rendermode InteractiveServer

<div class="matches-tab-shell">
    <div class="matches-tab-header">
        <div>
            <span class="section-eyebrow">Matches</span>
            <h2>Bracket view</h2>
            <p>@Game.Matches.Count() matches are currently loaded for this tournament.</p>
        </div>
    </div>

    @if(!Game.Matches.Any())
    {
        <div class="brand-card matches-empty-state">
            <h3>No bracket data yet</h3>
            <p>Match information will appear here once the tournament has been seeded and scheduled.</p>
        </div>
    }
    else
    {
        @switch(Game.BracketType)
        {
            case BracketType.DoubleElimination:
                <DoubleEliminationBracketComponent OnDataReload="OnDataReload" Game="@Game" />
                break;
            case BracketType.SingleElimination:
                <SingleEliminationBracketComponent OnDataReload="OnDataReload" Game="@Game" />
                break;
            default:
                <p>Bracket type not supported.</p>
                break;
        }
    }
</div>
