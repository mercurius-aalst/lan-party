@rendermode InteractiveServer
@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.DTOs.Games
@using Mercurius.LAN.Web.Models.Games
@using Mercurius.LAN.Web.Extensions

<div>
    @if(_isDialogOpen)
    {
        <div class="game-editor-modal-overlay" @onclick="() => CloseDialog(null)">
            <div class="game-editor-modal-dialog" @onclick:stopPropagation>
                <button type="button" class="game-editor-modal-close" aria-label="Close add tournament dialog" @onclick="() => CloseDialog(null)">&times;</button>
                <div class="game-editor-modal-header">
                    <span class="section-eyebrow">Admin</span>
                    <h3>Add tournament</h3>
                    <p>Create a new tournament entry without leaving the overview page.</p>
                </div>

                <div class="form-container w-full max-w-none p-0">
                    <EditForm EditContext="_editContext" OnValidSubmit="SubmitGameAsync" class="game-editor-form">
                        <DataAnnotationsValidator />

                        <div class="form-group">
                            <label for="name" class="form-label">Name</label>
                            <InputText id="name" class="form-control" @bind-Value="_newGame.Name" />
                            <ValidationMessage For="@(() => _newGame.Name)"/>
                        </div>

                        <div class="form-group-inline grid gap-4 lg:grid-cols-2">
                            <div class="form-group">
                                <label for="bracketType">Bracket Type</label>
                                <InputSelect id="bracketType" class="form-control" @bind-Value="_newGame.BracketType">
                                    @foreach(BracketType type in Enum.GetValues(typeof(BracketType)))
                                    {
                                        <option value="@type">@type.GetLabel()</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newGame.BracketType)" />
                            </div>

                            <div class="form-group">
                                <label for="participationMode">Participation Mode</label>
                                <InputSelect id="participationMode" class="form-control" @bind-Value="_newGame.ParticipationMode">
                                    @foreach(ParticipationMode type in Enum.GetValues(typeof(ParticipationMode)))
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newGame.ParticipationMode)" />
                            </div>
                        </div>

                        <div class="form-group-inline grid gap-4 lg:grid-cols-2">
                            <div class="form-group">
                                <label for="format">Format</label>
                                <InputSelect id="format" class="form-control" @bind-Value="_newGame.Format">
                                    @foreach(GameFormat type in Enum.GetValues(typeof(GameFormat)))
                                    {
                                        <option value="@type">@type.GetLabel()</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newGame.Format)" />
                            </div>

                            <div class="form-group">
                                <label for="finalsFormat">Finals Format</label>
                                <InputSelect id="finalsFormat" class="form-control" @bind-Value="_newGame.FinalsFormat">
                                    @foreach(GameFormat type in Enum.GetValues(typeof(GameFormat)))
                                    {
                                        <option value="@type">@type.GetLabel()</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newGame.FinalsFormat)" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="registrationUrl">Registration form url</label>
                            <InputText id="registrationUrl" class="form-control" @bind-Value="_newGame.RegisterFormUrl" />
                            <ValidationMessage For="@(() => _newGame.RegisterFormUrl)" />
                        </div>
                        <div class="form-group">
                            <label for="gameImage">Game Image</label>
                            <CustomInputFile @ref="_imageInputRef" id="gameImage" @bind-Value="_newGame.Image" />
                            <ValidationMessage For="@(() => _newGame.Image)" />
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="button-primary">Create tournament</button>
                            <button type="button" class="button-secondary" @onclick="() => CloseDialog(null)">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>
