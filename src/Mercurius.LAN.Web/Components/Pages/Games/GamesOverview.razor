@page "/games"
@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.Extensions
@using Mercurius.LAN.Web.Models.Games
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer
<PageTitle>Games</PageTitle>

@if(_isLoading)
{
    <LoadingScreen Message="Loading tournaments..." />
}
else
{
    <section class="games-hero brand-section">
        <div class="games-hero-copy">
            <span class="section-eyebrow">Compete. Connect. Create memories.</span>
            <h1>Games &amp; Tournaments</h1>
            <p>Browse the current Mercurius LAN tournaments, compare formats, and jump into the competitions that still have room for registrations.</p>
            <div class="games-hero-actions">
                <a href="/#tickets" class="button-primary">Get Tickets</a>
                <a href="/#schedule" class="button-secondary">Event Schedule</a>
            </div>
        </div>

        <div class="brand-panel-dark games-hero-panel">
            <span class="section-eyebrow games-hero-panel-label">Current event snapshot</span>
            <div class="games-hero-stats">
                <div>
                    <span class="games-stat-value">@_games.Count</span>
                    <span class="games-stat-label">Tournaments</span>
                </div>
                <div>
                    <span class="games-stat-value">@OpenRegistrationCount</span>
                    <span class="games-stat-label">Open registration</span>
                </div>
                <div>
                    <span class="games-stat-value">@TeamTournamentCount</span>
                    <span class="games-stat-label">Team events</span>
                </div>
            </div>
            <p class="games-hero-panel-copy">@EventWindow</p>
        </div>
    </section>

    <section class="brand-card games-toolbar">
        <div class="games-toolbar-search">
            <label for="games-search">Search tournaments</label>
            <input id="games-search" type="text" class="games-search-input" placeholder="Search by game title..." @bind="_searchTerm" @bind:event="oninput" />
        </div>

        <div class="games-toolbar-sort">
            <label for="games-sort">Sort by</label>
            <select id="games-sort" class="games-sort-select" @bind="_sortOption">
                <option value="@GameSortOption.StartTime">Start time</option>
                <option value="@GameSortOption.Name">Name</option>
                <option value="@GameSortOption.Status">Status</option>
            </select>
        </div>
    </section>

    <section class="games-filter-section">
        <div class="games-filter-group">
            <span class="section-eyebrow">Status</span>
            <div class="games-filter-chip-row">
                @foreach(var filter in StatusFilters)
                {
                    <button type="button" class="games-filter-chip @(filter.Value == _statusFilter ? "is-active" : null)" aria-pressed="@(filter.Value == _statusFilter)" @onclick="() => SetStatusFilter(filter.Value)">
                        @filter.Label
                    </button>
                }
            </div>
        </div>

        <div class="games-filter-group">
            <span class="section-eyebrow">Mode</span>
            <div class="games-filter-chip-row">
                @foreach(var filter in ParticipationFilters)
                {
                    <button type="button" class="games-filter-chip @(filter.Value == _participationFilter ? "is-active" : null)" aria-pressed="@(filter.Value == _participationFilter)" @onclick="() => SetParticipationFilter(filter.Value)">
                        @filter.Label
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="brand-section">
        <div class="games-results-header">
            <div>
                <span class="section-eyebrow">Tournament grid</span>
                <h2>@ResultsHeading</h2>
                <p>@ResultsSummary</p>
            </div>
            <a href="/#contact" class="button-secondary">Need event info?</a>
        </div>

        @if(FilteredGames.Count == 0)
        {
            <div class="brand-card games-empty-state">
                <h3>No tournaments match the current filters.</h3>
                <p>Adjust the search, status, or mode filters to see the full line-up again.</p>
            </div>
        }
        else
        {
            <div class="games-grid">
                <AuthorizeView Roles="admin">
                    <Authorized>
                        <button type="button" class="brand-card games-add-card" @onclick="ShowAddGameDialog">
                            <span class="brand-section-number">Admin</span>
                            <h3>Add Tournament</h3>
                            <p>Create a new game entry without leaving the overview page.</p>
                            <span class="games-add-card-icon" aria-hidden="true">+</span>
                        </button>
                    </Authorized>
                </AuthorizeView>

                @foreach(var game in FilteredGames)
                {
                    var imageUrl = AssetUrlResolver.Resolve(Configuration, game.ImageUrl);
                    <article class="brand-card games-card">
                        <img src="@imageUrl" alt="@game.Name" class="games-card-image" />
                        <div class="games-card-body">
                            <div class="games-card-topline">
                                <span class="games-card-date">@FormatDateTime(game.StartTime)</span>
                                <span class="game-status @game.Status.GetStatusClass()">@game.Status.GetStatusLabel()</span>
                            </div>

                            <h3>@game.Name</h3>

                            <div class="games-card-badges">
                                <span class="badge">@game.ParticipationMode.GetLabel()</span>
                                <span class="badge">@game.BracketType.GetLabel()</span>
                            </div>

                            <dl class="games-card-meta">
                                <div>
                                    <dt>Format</dt>
                                    <dd>@game.Format.GetLabel()</dd>
                                </div>
                                <div>
                                    <dt>Finals</dt>
                                    <dd>@game.FinalsFormat.GetLabel()</dd>
                                </div>
                                <div>
                                    <dt>Ends</dt>
                                    <dd>@FormatDateTime(game.EndTime)</dd>
                                </div>
                            </dl>
                        </div>

                        <div class="games-card-actions">
                            <button type="button" class="button-secondary" @onclick="() => NavigateToGameDetail(game.Id)">View Details</button>
                            <button type="button" class="button-primary" disabled="@(!CanRegister(game))" @onclick="() => NavigateToRegister(game)">
                                @(CanRegister(game) ? "Register" : "Registration Closed")
                            </button>
                        </div>
                    </article>
                }
            </div>
        }

        @if(_isAddGameDialogOpen)
        {
            <AddGameDialog OnClose="CloseAddGameDialog" />
        }
    </section>

    <section class="brand-section">
        <div class="games-results-header">
            <div>
                <span class="section-eyebrow">How tournaments work</span>
                <h2>From registration to finals</h2>
            </div>
        </div>

        <div class="games-process-grid">
            <article class="brand-card games-process-card">
                <span class="brand-section-number">01</span>
                <h3>Pick your tournament</h3>
                <p>Use the filters to compare game formats, bracket structure, and whether the event is solo or team-based.</p>
            </article>

            <article class="brand-card games-process-card">
                <span class="brand-section-number">02</span>
                <h3>Register while it is open</h3>
                <p>Scheduled tournaments keep their registration links available so players can lock in before matches begin.</p>
            </article>

            <article class="brand-card games-process-card">
                <span class="brand-section-number">03</span>
                <h3>Show up ready to play</h3>
                <p>Bring your setup, keep your profile current, and watch the bracket once the event moves into progress.</p>
            </article>
        </div>
    </section>

    <section class="brand-section">
        <div class="brand-card games-callout">
            <div>
                <span class="section-eyebrow">Need more context?</span>
                <h2>Plan your LAN weekend</h2>
                <p>Use the Home page for schedule anchors and the Sponsors page for partner information while the tournament list stays focused on gameplay.</p>
            </div>
            <div class="games-callout-actions">
                <a href="/#schedule" class="button-secondary">View Schedule</a>
                <a href="/sponsors" class="button-primary">Meet Sponsors</a>
            </div>
        </div>
    </section>
}

<SponsorScroller />
