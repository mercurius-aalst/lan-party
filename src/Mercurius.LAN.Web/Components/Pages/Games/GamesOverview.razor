@page "/games"
@using Mercurius.LAN.Web.Extensions
@using Mercurius.LAN.Web.Models.Games
@using Mercurius.LAN.Web.Models
@using Mercurius.LAN.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer
<PageTitle>Games & Tournaments</PageTitle>

<section class="games-hero">
  <div>
    <p class="section-eyebrow">Compete. Connect. Create memories.</p>
    <h1>Games & Tournaments</h1>
    <p>Explore every competition at Mercurius LAN. From intense showdowns to casual fun, there's a tournament for every playstyle.</p>
    <div class="dark-brand-block strip"><span>8 tournaments</span><span>BYOC friendly</span><span>Registration open</span></div>
  </div>
</section>

<section class="brand-card controls">
  <div class="filters"><button class="button-primary">All</button><button class="button-secondary">FPS</button><button class="button-secondary">MOBA</button><button class="button-secondary">Sports</button></div>
  <input type="text" class="search" placeholder="Search tournaments..." @bind="_searchTerm" @bind:event="oninput" />
</section>

@if(_games == null){ <LoadingScreen Message="Loading..." /> }
else {
<div class="grid">
@foreach(var game in FilteredGames){
var imageUrl = Configuration["MercuriusAPI:BaseAddress"] + game.ImageUrl;
<div class="brand-card game-card" @onclick="() => NavigateToGameDetail(game.Id)">
<img src="@imageUrl" alt="@game.Name" />
<div class="body"><h3>@game.Name</h3><span class="badge-brand">@game.BracketType.GetLabel()</span><p class="status">@game.Status.GetStatusLabel()</p><a class="button-secondary" @onclick:stopPropagation @onclick="() => NavigateToGameDetail(game.Id)">View Details</a></div>
</div>
}
</div>
}
