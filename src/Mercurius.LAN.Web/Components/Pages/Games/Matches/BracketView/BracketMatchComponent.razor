@using Mercurius.LAN.Web.Components.Pages.Games.Matches.DetailView

@rendermode InteractiveServer

<div class="bracket-match @ExtraCssClasses" style="@(Position.HasValue ? $"left:{Position.Value.left}px; top:{Position.Value.y}px;" : string.Empty)" @onclick="DisplayDetails">
    <MatchParticipantRow Match="@Match" ParticipantName="@Participant1Name" ParticipantId="@Participant1Id" SequenceNumber="1"></MatchParticipantRow>
    <MatchParticipantRow Match="@Match" ParticipantName="@Participant2Name" ParticipantId="@Participant2Id" SequenceNumber="2"></MatchParticipantRow>
</div>

@if(_showDialog)
{
    <MatchDetailsDialog Match="@Match" Game="@Game" Participant1Name="@Participant1Name" Participant2Name="@Participant2Name" OnClose="CloseDetailsDialogAsync" OnDataReload="OnDataReload" />
}
