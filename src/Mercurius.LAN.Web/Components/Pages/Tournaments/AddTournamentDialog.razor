@rendermode InteractiveServer
@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.DTOs.Tournaments
@using Mercurius.LAN.Web.Models.Tournaments
@using Mercurius.LAN.Web.Extensions

<div>
    @if(_isDialogOpen)
    {
        <div class="Tournament-editor-modal-overlay" @onclick="() => CloseDialog(null)">
            <div class="Tournament-editor-modal-dialog" @onclick:stopPropagation>
                <button type="button" class="Tournament-editor-modal-close" aria-label="Close add tournament dialog" @onclick="() => CloseDialog(null)">&times;</button>
                <div class="Tournament-editor-modal-header">
                    <span class="section-eyebrow">Admin</span>
                    <h3>Add tournament</h3>
                    <p>Create a new tournament entry without leaving the overview page.</p>
                </div>

                <div class="form-container Tournament-editor-form-container">
                    <EditForm EditContext="_editContext" OnValidSubmit="SubmitTournamentAsync" class="Tournament-editor-form">
                        <DataAnnotationsValidator />

                        <div class="form-group">
                            <label for="name" class="form-label">Name</label>
                            <InputText id="name" class="form-control" @bind-Value="_newTournament.Name" />
                            <ValidationMessage For="@(() => _newTournament.Name)"/>
                        </div>

                        <div class="form-group-inline grid gap-4 lg:grid-cols-2">
                            <div class="form-group">
                                <label for="bracketType">Bracket Type</label>
                                <InputSelect id="bracketType" class="form-control" @bind-Value="_newTournament.BracketType">
                                    @foreach(var type in SupportedBracketTypes)
                                    {
                                        <option value="@type">@type.GetLabel()</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newTournament.BracketType)" />
                            </div>

                            <div class="form-group">
                                <label for="participationMode">Participation Mode</label>
                                <InputSelect id="participationMode" class="form-control" @bind-Value="_newTournament.ParticipationMode">
                                    @foreach(ParticipationMode type in Enum.GetValues(typeof(ParticipationMode)))
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newTournament.ParticipationMode)" />
                            </div>

                            @if(_newTournament.ParticipationMode == ParticipationMode.Team)
                            {
                                <div class="form-group">
                                    <label for="teamSize">Team size</label>
                                    <InputNumber id="teamSize" class="form-control" @bind-Value="_newTournament.TeamSize" min="1" max="50" />
                                    <small class="form-help">Every team must submit exactly this many players.</small>
                                    <ValidationMessage For="@(() => _newTournament.TeamSize)" />
                                </div>
                            }
                        </div>

                        <div class="form-group-inline grid gap-4 lg:grid-cols-2">
                            <div class="form-group">
                                <label for="format">Format</label>
                                <InputSelect id="format" class="form-control" @bind-Value="_newTournament.Format">
                                    @foreach(TournamentFormat type in Enum.GetValues(typeof(TournamentFormat)))
                                    {
                                        <option value="@type">@type.GetLabel()</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newTournament.Format)" />
                            </div>

                            <div class="form-group">
                                <label for="finalsFormat">Finals Format</label>
                                <InputSelect id="finalsFormat" class="form-control" @bind-Value="_newTournament.FinalsFormat">
                                    @foreach(TournamentFormat type in Enum.GetValues(typeof(TournamentFormat)))
                                    {
                                        <option value="@type">@type.GetLabel()</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _newTournament.FinalsFormat)" />
                            </div>
                        </div>
                        <div class="Tournament-editor-schedule-fields">
                            <div class="form-group">
                                <label>Planned start time</label>
                                <div class="Tournament-editor-datetime-row">
                                    <MudDatePicker Date="@_plannedStartDate"
                                                   DateChanged="HandlePlannedStartDateChanged"
                                                   DateFormat="dd/MM/yyyy"
                                                   Placeholder="Date"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Clearable="false"
                                                   Class="Tournament-editor-mud-picker" />
                                    <MudTimePicker Time="@_plannedStartTime"
                                                   TimeChanged="HandlePlannedStartTimeChanged"
                                                   AmPm="false"
                                                   TimeFormat="HH:mm"
                                                   Placeholder="Time"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Clearable="false"
                                                   Class="Tournament-editor-mud-picker" />
                                </div>
                                <ValidationMessage For="@(() => _newTournament.PlannedStartTime)" />
                                @if(!string.IsNullOrWhiteSpace(_plannedStartTimeError))
                                {
                                    <div class="validation-message">@_plannedStartTimeError</div>
                                }
                            </div>

                            <div class="Tournament-editor-duration-row">
                                <div class="form-group">
                                    <label for="averageGameDuration">Average game duration (minutes)</label>
                                    <InputNumber id="averageGameDuration" class="form-control" @bind-Value="_newTournament.AverageGameDurationMinutes" />
                                    <ValidationMessage For="@(() => _newTournament.AverageGameDurationMinutes)" />
                                </div>

                                <div class="form-group">
                                    <label for="roundBreakDuration">Round break (minutes)</label>
                                    <InputNumber id="roundBreakDuration" class="form-control" @bind-Value="_newTournament.RoundBreakDurationMinutes" />
                                    <ValidationMessage For="@(() => _newTournament.RoundBreakDurationMinutes)" />
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="tournamentImage">Tournament Image</label>
                            <CustomInputFile @ref="_imageInputRef" id="tournamentImage" @bind-Value="_newTournament.Image" />
                            <ValidationMessage For="@(() => _newTournament.Image)" />
                        </div>

                        @if(_submitError is not null)
                        {
                            <div class="validation-message" role="alert">@_submitError</div>
                        }

                        <div class="form-actions">
                            <button type="submit" class="button-primary" disabled="@_isSubmitting">@(_isSubmitting ? "Creating..." : "Create tournament")</button>
                            <button type="button" class="button-secondary" @onclick="() => CloseDialog(null)">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>
