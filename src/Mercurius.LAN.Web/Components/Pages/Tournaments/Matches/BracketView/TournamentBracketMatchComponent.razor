@using Mercurius.LAN.Web.Components.Pages.Tournaments.Matches.DetailView

@rendermode InteractiveServer

<div class="bracket-match @ExtraCssClasses" style="@(Position.HasValue ? $"left:{Position.Value.left}px; top:{Position.Value.y}px;" : string.Empty)" @onclick="DisplayDetails">
    <MatchParticipantRow Match="@Match" ParticipantName="@Participant1Name" Participant="@ResolveParticipant(Participant1Id)" ParticipantId="@Participant1Id" SequenceNumber="1"></MatchParticipantRow>
    <MatchParticipantRow Match="@Match" ParticipantName="@Participant2Name" Participant="@ResolveParticipant(Participant2Id)" ParticipantId="@Participant2Id" SequenceNumber="2"></MatchParticipantRow>
</div>

@if(_showDialog)
{
    <TournamentMatchDetailsDialog Match="@Match" Tournament="@Tournament" Participant1Name="@Participant1Name" Participant2Name="@Participant2Name" Participant1="@ResolveParticipant(Participant1Id)" Participant2="@ResolveParticipant(Participant2Id)" OnClose="CloseDetailsDialogAsync" OnDataReload="HandleMatchDataReloadAsync" OnMatchRefreshed="HandleMatchRefreshedAsync" />
}
