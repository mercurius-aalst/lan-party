@rendermode InteractiveServer
@using Mercurius.LAN.Web.DTOs.Users
@using Mercurius.LAN.Web.Models.Tournaments
@using Mercurius.LAN.Web.Models.Matches
@using Mercurius.LAN.Web.Models.Participants

<div class="placements-container">
    <div class="placements-header-block">
        <h2 class="section-eyebrow">@Localization["tournament.placements"]</h2>
    </div>

    @if(Placements == null || !Placements.Any())
    {
        <div class="brand-card placements-empty-state">
            <p>@Localization["status.noResults"]</p>
        </div>
    }
    else
    {
        <div class="podium">
            @foreach(var placement in Placements.OrderBy(p => p.Place).Take(3))
            {
                <div class="podium-step @(placement.Place == 1 ? "gold" : placement.Place == 2 ? "silver" : "bronze")">
                    <div class="participant-name">
                        @if(ParticipationMode == ParticipationMode.Team)
                        {
                            @foreach(var team in placement.Teams)
                            {
                                <TeamIdentityDisplay Name="@team.Name" LogoUrl="@team.LogoUrl" Href="@BuildTeamProfileHref(team.Name)" Variant="placement" Size="small" />
                            }
                        }
                        else
                        {
                            @foreach(var participantName in GetUserParticipantNames(placement))
                            {
                                @participantName
                                <br />
                            }
                        }
                    </div>
                    <div class="placement-title">@GetOrdinalLabel(placement.Place)</div>
                </div>
            }
        </div>
        <ol class="placements-list">
            @foreach(var placement in Placements.OrderBy(p => p.Place).Skip(3))
            {
                <li class="placement-item">
                    <span class="placement-title">@Localization.Get("Feature.tournaments.placementPlace", GetOrdinalLabel(placement.Place))</span>
                    <ul class="participant-list">
                        @if(ParticipationMode == ParticipationMode.Team)
                        {
                            @foreach(var team in placement.Teams)
                            {
                                <li class="participant-item participant-item--team">
                                    <TeamIdentityDisplay Name="@team.Name" LogoUrl="@team.LogoUrl" Href="@BuildTeamProfileHref(team.Name)" Variant="placement" Size="compact" />
                                </li>
                            }
                        }
                        else
                        {
                            @foreach(var participantName in GetUserParticipantNames(placement))
                            {
                                <li class="participant-item">@participantName</li>
                            }
                        }
                    </ul>
                </li>
            }
        </ol>
    }
</div>
