@using Mercurius.LAN.Web.Components.Pages.Tournaments.Matches.BracketView
@using Mercurius.LAN.Web.Models.Tournaments
@rendermode InteractiveServer

<div class="matches-tab-shell">
    <div class="matches-tab-header">
        <div>
        <h2 class="section-eyebrow">@Localization["tournament.matches"]</h2>
        </div>
    </div>

    @if(!Tournament.Matches.Any())
    {
        <div class="matches-empty-state">
            <h3>@Localization["Feature.tournaments.bracketEmptyHeading"]</h3>
            <p>@Localization["Feature.tournaments.bracketEmptyText"]</p>
        </div>
    }
    else
    {
        @switch(Tournament.BracketType)
        {
            case BracketType.DoubleElimination:
                <DoubleEliminationTournamentBracketComponent OnDataReload="OnDataReload" OnMatchRefreshed="OnMatchRefreshed" Tournament="@Tournament" />
                break;
            case BracketType.SingleElimination:
                <SingleEliminationTournamentBracketComponent OnDataReload="OnDataReload" OnMatchRefreshed="OnMatchRefreshed" Tournament="@Tournament" />
                break;
            default:
                <p>@Localization["Feature.tournaments.bracketUnsupported"]</p>
                break;
        }
    }
</div>
