@rendermode InteractiveServer
@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.DTOs.Registrations
@using Mercurius.LAN.Web.Models.Tournaments

<div class="participants-tab-shell">
    <div class="participants-tab-header">
        <div>
            <span class="section-eyebrow">Participants</span>
            <h2>Registered @(Tournament.ParticipationMode == ParticipationMode.Team ? "teams" : "players")</h2>
            <p>@_participants.Count currently registered for this tournament.</p>
        </div>
    </div>

    <div class="participants-overview-body">
        @if(!HasPublicParticipants)
        {
            <div class="participants-state-card" role="status">
                <h3>No participants yet</h3>
                <p>Registrations will appear here after the backend confirms them.</p>
            </div>
        }
        else
        {
            <div class="participants-overview-grid">
                @foreach(var participant in _participants)
                {
                    <ParticipantCardComponent Participant="participant" OnParticipantSelected="DisplayParticipantPopup" />
                }
            </div>
        }

        <section class="registration-panel" aria-labelledby="registration-panel-heading">
            <div class="registration-panel-header">
                <div>
                    <span class="section-eyebrow">Registration</span>
                    <h3 id="registration-panel-heading">Join this tournament</h3>
                    <p>@GetRegistrationStateMessage()</p>
                </div>
                @if(_isLoadingRegistration)
                {
                    <span class="registration-loading" role="status">Checking options...</span>
                }
                @if(_isAuthenticated && IsRegistrationOpen)
                {
                    <button type="button" class="button-link" disabled="@(_isSubmitting || _isLoadingRegistration || _isLoadingTeams || _isLoadingRoster)" @onclick="RetryRegistrationContextAsync">Refresh registration state</button>
                }
            </div>

            @if(_registrationError is not null)
            {
                <div class="registration-message registration-message--error" role="alert">
                    <p>@_registrationError</p>
                    <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="RetryRegistrationContextAsync">Try again</button>
                </div>
            }

            @if(_isAuthenticated && IsRegistrationOpen && Tournament.ParticipationMode == ParticipationMode.Individual)
            {
                <div class="registration-workflow">
                    @if(_registrationState?.IndividualRegistration is { } individualRegistration)
                    {
                        <p class="registration-message registration-message--success">Your registration is @individualRegistration.Status.ToString().ToLowerInvariant().</p>
                        @if(_registrationState.CanUnregister)
                        {
                            <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="UnregisterIndividualAsync">Unregister</button>
                        }
                    }
                    else if(_individualEligibility is null)
                    {
                        <p class="registration-message" role="status">Checking your eligibility...</p>
                    }
                    else if(!_individualEligibility.Eligible)
                    {
                        <p class="registration-message registration-message--warning">You cannot register yet: @GetReasonText(_individualEligibility.ReasonCodes)</p>
                    }
                    else if(_registrationState?.CanRegisterIndividual == true)
                    {
                        <button type="button" class="button-primary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="RegisterIndividualAsync">Register as an individual</button>
                    }
                    else
                    {
                        <p class="registration-message registration-message--warning">Your account is not currently eligible to register. Refresh to re-check the backend state.</p>
                    }
                </div>
            }
            else if(_isAuthenticated && IsRegistrationOpen && Tournament.ParticipationMode == ParticipationMode.Team)
            {
                <div class="registration-workflow registration-workflow--team">
                    @if(_teamError is not null)
                    {
                        <div class="registration-message registration-message--error" role="alert">
                            <p>@_teamError</p>
                            @if(_teamSummaryUnavailable || _teamEligibilityUnavailable)
                            {
                                <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="RetryTeamRegistrationAsync">Retry team checks</button>
                            }
                            @if(_rosterEligibilityUnavailable)
                            {
                                <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration || _isLoadingRoster)" @onclick="RetryRosterEligibilityAsync">Retry roster check</button>
                            }
                            @if(!_teamSummaryUnavailable && !_teamEligibilityUnavailable && !_rosterEligibilityUnavailable)
                            {
                                <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="RetryRegistrationContextAsync">Refresh registration state</button>
                            }
                        </div>
                    }

                    @if(_isLoadingTeams)
                    {
                        <p class="registration-message" role="status">Loading your captained teams...</p>
                    }
                    else if(_teamSummaryUnavailable)
                    {
                        <div class="registration-message registration-message--error" role="alert">
                            <p>Your team summary is unavailable, so team registration cannot be loaded yet.</p>
                            <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="RetryTeamRegistrationAsync">Retry team summary</button>
                        </div>
                    }
                    else if(!CaptainedTeams.Any())
                    {
                        @if(_registrationState?.ActiveTeamRegistration is { Team: not null } activeTeam && !HasCaptainManagedRegistration)
                        {
                            <div class="registration-message registration-message--warning" role="status">
                                <strong>You are registered on @activeTeam.Team.Name.</strong>
                                <p>Roster changes and unregistering are managed by the team captain or an administrator. Confirmed members cannot remove themselves.</p>
                            </div>
                        }
                        else
                        {
                            <p class="registration-message registration-message--warning">You do not captain a team that can submit a roster. Team membership alone cannot submit a registration.</p>
                        }
                    }
                    else
                    {
                        @if(_registrationState?.ActiveTeamRegistration is { Team: not null } activeTeam && !HasCaptainManagedRegistration)
                        {
                            <div class="registration-message registration-message--warning" role="status">
                                <strong>You are registered on @activeTeam.Team.Name.</strong>
                                <p>Roster changes and unregistering are managed by the team captain or an administrator. You can still manage any other team you captain.</p>
                            </div>
                        }
                        <MudStepper @ref="_teamRegistrationStepper"
                                    ActiveIndex="@_activeTeamStep"
                                    ActiveIndexChanged="HandleTeamStepChangedAsync"
                                    NonLinear="false"
                                    ShowResetButton="false"
                                    Class="registration-stepper">
                            <ChildContent>
                                <MudStep Title="Select team" SecondaryText="Captain-owned team" Completed="@(_activeTeamStep > 0)">
                                <div class="registration-step-content">
                                    <p class="registration-help">Choose a team you captain. Eligibility is checked by the backend before the roster can be edited.</p>
                                    <div class="registration-team-options" role="listbox" aria-label="Teams you captain">
                                        @foreach(var team in CaptainedTeams)
                                        {
                                            var teamEligibility = GetTeamEligibility(team.Id);
                                            var teamSelectable = CanSelectTeam(team.Id);
                                            var teamReasonId = $"team-reason-{team.Id:N}";
                                            <button type="button"
                                                    class="registration-team-option @(team.Id == _selectedTeamId ? "is-selected" : null)"
                                                    role="option"
                                                    aria-selected="@(team.Id == _selectedTeamId)"
                                                    aria-describedby="@(teamEligibility is { Eligible: false } ? teamReasonId : null)"
                                                    disabled="@(!teamSelectable || _isSubmitting || _isLoadingRegistration || _isLoadingTeams || _isLoadingRoster)"
                                                    @onclick="() => SelectTeamAsync(team.Id)">
                                                <span>
                                                    <strong>@team.Name</strong>
                                                    <small>@team.Members.Count member(s)</small>
                                                </span>
                                                @if(teamEligibility is null)
                                                {
                                                    <small class="registration-team-status">Eligibility is still being checked.</small>
                                                }
                                                else if(teamSelectable && IsCurrentCaptainManagedTeam(team.Id))
                                                {
                                                    <small class="registration-team-status registration-team-status--success">Existing registration can be edited.</small>
                                                }
                                                else if(!teamEligibility.Eligible)
                                                {
                                                    <small id="@teamReasonId" class="registration-team-status registration-team-status--error">Unavailable: @GetReasonText(teamEligibility.ReasonCodes)</small>
                                                }
                                                else
                                                {
                                                    <small class="registration-team-status registration-team-status--success">Eligible</small>
                                                }
                                            </button>
                                        }
                                    </div>

                                    @if(SelectedTeam is null)
                                    {
                                        <p class="registration-message registration-message--warning">Select an eligible team to continue.</p>
                                    }
                                        else if(!CanAdvanceFromTeamSelection)
                                        {
                                            <p class="registration-message registration-message--warning">This team cannot be used for this tournament: @GetReasonText(_selectedTeamEligibility?.ReasonCodes ?? [])</p>
                                        }
                                        @if(_teamEligibilityUnavailable && !_isLoadingTeams)
                                        {
                                            <p class="registration-message registration-message--error" role="alert">Team eligibility is unavailable. Retry the team checks before continuing.</p>
                                        }
                                </div>
                                </MudStep>

                                <MudStep Title="Select roster" SecondaryText="Exact team size" Disabled="@(!CanAdvanceFromTeamSelection)" Completed="@(_activeTeamStep > 1)">
                                <div class="registration-step-content">
                                    @if(SelectedTeam is not null)
                                    {
                                        <div class="registration-form-grid">
                                            <div>
                                                <span class="section-eyebrow">Selected team</span>
                                                <strong>@SelectedTeam.Name</strong>
                                            </div>
                                            <div class="registration-roster-summary">
                                                <span class="section-eyebrow">Roster size</span>
                                                <strong>@_selectedRosterUserIds.Count / @RequiredTeamSize</strong>
                                                <small>Exactly @RequiredTeamSize player(s), including the captain.</small>
                                            </div>
                                        </div>

                                        @if(HasCaptainManagedRegistration)
                                        {
                                            <p class="registration-message registration-message--success">Your team registration is @CaptainManagedRegistration!.Status.ToString().ToLowerInvariant() and can be edited while registration is open.</p>
                                        }

                                        @if(_selectedTeamEligibility is { Eligible: false } && !IsCurrentCaptainManagedTeam(SelectedTeam.Id))
                                        {
                                            <p class="registration-message registration-message--warning">This team cannot register: @GetReasonText(_selectedTeamEligibility.ReasonCodes)</p>
                                        }
                                        else if(_selectedTeamEligibility is { Eligible: false })
                                        {
                                            <p class="registration-message registration-message--warning">The eligibility response includes the existing registration conflict. The current captain can edit this roster; the backend will revalidate the replacement on save.</p>
                                        }

                                        <fieldset class="registration-roster-fieldset">
                                            <legend>Roster members</legend>
                                            <p class="registration-help">The captain must remain selected. A checked member with a blocking reason can be removed, but cannot be added back until eligible.</p>
                                            <div class="registration-roster-list">
                                                @foreach(var member in EditableRosterCandidates)
                                                {
                                                    var candidate = GetRosterCandidate(member.Id);
                                                    var reasonId = $"roster-reason-{member.Id:N}";
                                                    var selected = _selectedRosterUserIds.Contains(member.Id);
                                                    var isCurrentTeamMember = IsCurrentTeamMember(member.Id);
                                                    var isCaptain = member.Id == SelectedTeam.CaptainUserId;
                                                    var blocked = candidate is { Eligible: false } && !IsExistingRosterConflictAllowed(member.Id, candidate);
                                                    <label class="registration-roster-member @(blocked ? "registration-roster-member--ineligible" : null) @(selected ? "is-selected" : null)">
                                                        <input type="checkbox"
                                                               checked="@selected"
                                                               disabled="@(_isSubmitting || _isLoadingRegistration || _isLoadingRoster || isCaptain || (!selected && blocked))"
                                                               aria-describedby="@((!isCurrentTeamMember || candidate is { Eligible: false }) ? reasonId : null)"
                                                               @onchange="args => ToggleRosterMemberAsync(member.Id, args)" />
                                                        <span class="registration-roster-member-copy">
                                                            <strong>@GetUserLabel(member)</strong>@(isCaptain ? " (captain)" : string.Empty)
                                                            @if(!isCurrentTeamMember || candidate is { Eligible: false })
                                                            {
                                                                <small id="@reasonId" class="registration-candidate-reason">
                                                                    @if(!isCurrentTeamMember)
                                                                    {
                                                                        <span>Former team member; remove before saving this roster.</span>
                                                                    }
                                                                    @if(candidate is { Eligible: false })
                                                                    {
                                                                        <span>@GetReasonText(candidate.ReasonCodes)</span>
                                                                    }
                                                                </small>
                                                            }
                                                            else if(_isLoadingRoster)
                                                            {
                                                                <small class="registration-candidate-reason">Checking eligibility...</small>
                                                            }
                                                        </span>
                                                    </label>
                                                }
                                            </div>
                                        </fieldset>

                                        @if(_isLoadingRoster)
                                        {
                                            <p class="registration-message" role="status">Checking the selected roster with the backend...</p>
                                        }
                                        else if(_rosterEligibilityUnavailable)
                                        {
                                            <div class="registration-message registration-message--error" role="alert">
                                                <p>Selected roster eligibility is unavailable. The roster cannot be submitted until it is checked.</p>
                                                <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration)" @onclick="RetryRosterEligibilityAsync">Retry roster check</button>
                                            </div>
                                        }
                                        else if(RequiredTeamSize <= 0)
                                        {
                                            <p class="registration-message registration-message--warning">The tournament has no valid team-size requirement.</p>
                                        }
                                        else if(_rosterEligibility is { Eligible: false } && !IsRosterEligibleForWorkflow)
                                        {
                                            <p class="registration-message registration-message--warning">This roster cannot be submitted: @GetReasonText(_rosterEligibility.ReasonCodes)</p>
                                        }
                                        else if(_rosterEligibility is { Eligible: false })
                                        {
                                            <p class="registration-message registration-message--warning">The eligibility service is reporting the current registration as a duplicate. Existing roster members may be kept while editing; all other reasons must be resolved.</p>
                                        }
                                        else if(_rosterEligibility is { Eligible: true })
                                        {
                                            <p class="registration-message registration-message--success">The selected roster is eligible.</p>
                                        }
                                    }
                                </div>
                                </MudStep>

                                <MudStep Title="Review & submit" SecondaryText="Confirm roster" Disabled="@(!CanSubmitRoster)">
                                <div class="registration-step-content">
                                    @if(SelectedTeam is not null)
                                    {
                                        <h4>Review @SelectedTeam.Name</h4>
                                        <dl class="registration-review-list">
                                            <div>
                                                <dt>Required size</dt>
                                                <dd>@RequiredTeamSize player(s), including the captain</dd>
                                            </div>
                                            <div>
                                                <dt>Selected roster</dt>
                                                <dd>@string.Join(", ", EditableRosterCandidates.Where(member => _selectedRosterUserIds.Contains(member.Id)).Select(GetUserLabel))</dd>
                                            </div>
                                            <div>
                                                <dt>Confirmation</dt>
                                                <dd>Non-captain members will remain pending until each selected member confirms.</dd>
                                            </div>
                                        </dl>
                                        @if(HasCaptainManagedRegistration)
                                        {
                                            <div class="registration-review-roster" aria-label="Current roster confirmation state">
                                                @foreach(var member in CaptainManagedRegistration!.RosterMembers)
                                                {
                                                    <span class="registration-review-member">
                                                        @GetUserLabel(member.User): @GetConfirmationLabel(member.ConfirmationStatus)
                                                    </span>
                                                }
                                            </div>
                                        }
                                        <p class="registration-help">The backend performs the final eligibility and authorization check when you save.</p>
                                    }
                                </div>
                                </MudStep>
                            </ChildContent>

                            <ActionContent>
                                <div class="registration-stepper-actions">
                                    <div>
                                        @if(_activeTeamStep > 0)
                                        {
                                            <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration || _isLoadingRoster)" @onclick="PreviousTeamStepAsync">Back</button>
                                        }
                                        @if(_activeTeamStep < 2)
                                        {
                                            <button type="button" class="button-primary" disabled="@(!CanAdvanceTeamStep || _isSubmitting || _isLoadingRegistration || _isLoadingRoster)" @onclick="NextTeamStepAsync">Next</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="button-primary" disabled="@(!CanSubmitRoster || _isSubmitting || _isLoadingRegistration || _isLoadingRoster)" @onclick="SubmitTeamRosterAsync">@(HasCaptainManagedRegistration ? "Save roster changes" : "Confirm team registration")</button>
                                        }
                                    </div>
                                    <button type="button" class="button-link" disabled="@(_isSubmitting || _isLoadingRegistration || _isLoadingRoster)" @onclick="ResetTeamStepper">Start over</button>
                                </div>
                            </ActionContent>
                        </MudStepper>

                        @if(CanUnregisterSelectedTeam)
                        {
                            <div class="registration-actions">
                                <button type="button" class="button-secondary" disabled="@(_isSubmitting || _isLoadingRegistration || _isLoadingRoster)" @onclick="UnregisterTeamAsync">Unregister team</button>
                            </div>
                        }
                    }
                </div>
            }
            else if(_isAuthenticated && !IsRegistrationOpen)
            {
                <p class="registration-message registration-message--warning">Registration is closed for this tournament. Existing registration actions are unavailable after the tournament starts.</p>
            }
            else if(!_isAuthenticated)
            {
                <div class="registration-message">
                    @if(IsRegistrationOpen)
                    {
                        <p>Sign in to access registration and eligibility actions.</p>
                        <a class="button-primary" href="@LoginUrl">Sign in to register</a>
                    }
                    else
                    {
                        <p>Registration is closed for this tournament. No registration action is available.</p>
                    }
                </div>
            }

            @if(_registrationState?.PendingRosterConfirmation is { } pending)
            {
                <div class="registration-confirmation" role="status">
                    <div>
                        <span class="section-eyebrow">Roster confirmation</span>
                        <p>Your place for <strong>@GetUserLabel(pending.User)</strong> in <strong>@Tournament.Name</strong> is waiting for your confirmation.</p>
                        <small class="registration-help">The current API does not include the team name in this pending state. Confirming is still subject to the backend's latest roster and tournament checks.</small>
                    </div>
                    <button type="button" class="button-primary" disabled="@(!CanConfirmPending || _isSubmitting || _isLoadingRegistration)" @onclick="ConfirmRosterMemberAsync">Confirm roster place</button>
                </div>
            }
        </section>

        @if(_isAdmin)
        {
            <section class="registration-panel registration-panel--admin" aria-labelledby="admin-registration-heading">
                <div class="registration-panel-header">
                    <div>
                        <span class="section-eyebrow">Admin</span>
                        <h3 id="admin-registration-heading">Registration administration</h3>
                        <p>Administrators can remove a registration. New registrations and roster confirmations remain user- or captain-owned.</p>
                    </div>
                    @if(_isLoadingAdmin)
                    {
                        <span class="registration-loading" role="status">Loading registrations...</span>
                    }
                </div>

                @if(_adminError is not null)
                {
                    <p class="registration-message registration-message--error" role="alert">@_adminError</p>
                }
                else if(!_isLoadingAdmin && _adminRegistrations.Count == 0)
                {
                    <p class="registration-message">No registrations are available to administer.</p>
                }
                else
                {
                    <div class="form-group">
                        <label for="admin-removal-reason">Removal reason (optional)</label>
                        <textarea id="admin-removal-reason" class="form-control" rows="2" @bind="_adminRemovalReason"></textarea>
                    </div>
                    <div class="admin-registration-list">
                        @foreach(var registration in _adminRegistrations)
                        {
                            var registrationLabel = registration.Kind == TournamentRegistrationKind.Team
                                ? registration.Team?.Name ?? "Unknown team"
                                : GetUserLabel(registration.User);
                            <div class="admin-registration-row">
                                <div>
                                    <strong>@registrationLabel</strong>
                                    <span>@registration.Kind · @registration.Status</span>
                                </div>
                                <button type="button" class="button-secondary" disabled="@(_pendingAdminRemovalRegistrationId.HasValue || _isLoadingRegistration)" @onclick="() => RemoveAdminRegistrationAsync(registration)">Remove</button>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>

    @if(_selectedParticipant is not null)
    {
        <div class="participants-modal-overlay" @onclick="HidePopup">
            <div class="participants-modal-dialog participants-modal-dialog--detail"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="participant-details-title"
                 aria-describedby="participant-details-summary"
                 tabindex="-1"
                 @onclick:stopPropagation>
                <button type="button" class="participants-modal-close" aria-label="Close participant details" @onclick="HidePopup">&times;</button>
                <div class="participants-modal-header">
                    <span class="section-eyebrow">Participant</span>
                    <h3 id="participant-details-title">@_selectedParticipant.DisplayName</h3>
                    <p id="participant-details-summary">@GetParticipantModalSummary()</p>
                </div>
                <ParticipantComponent Participant="_selectedParticipant" ShowIdentityHeader="false" />
            </div>
        </div>
    }
</div>
