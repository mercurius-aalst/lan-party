@page "/complete-profile"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Mercurius.LAN.Web.DTOs.Users

<PageTitle>Complete Profile</PageTitle>

@if(!string.IsNullOrWhiteSpace(_loadError))
{
    <StatusPage Eyebrow="Profile"
                Title="Profile setup unavailable"
                Message="@_loadError"
                PrimaryHref="/complete-profile"
                PrimaryLabel="Try Again"
                SecondaryHref="/"
                SecondaryLabel="Back home" />
}
else if(_editContext is null)
{
    <LoadingScreen />
}
else
{
    <section class="complete-profile-page">
        <header class="complete-profile-header brand-section">
            <span class="section-eyebrow">Account setup</span>
            <h1>Complete Profile</h1>
            <p>Finish your account details before registering for tournaments or appearing in competition data.</p>
        </header>

        <div class="complete-profile-layout">
            <section class="brand-card complete-profile-main-card">
                <div class="complete-profile-card-header">
                    <div>
                        <span class="section-eyebrow">Required details</span>
                        <h2>Create your player profile</h2>
                    </div>
                </div>

                @if(!string.IsNullOrWhiteSpace(_email))
                {
                    <div class="complete-profile-email-row">
                        <label class="form-label">Email</label>
                        <input class="form-control" value="@_email" disabled />
                    </div>
                }

                <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" FormName="complete-profile">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="complete-profile-form-grid">
                        <div class="form-group">
                            <label for="username">Username</label>
                            <InputText id="username" @bind-Value="_model.Username" @onblur="CheckUsernameAvailabilityAsync" class="form-control" />
                            <ValidationMessage For="@(() => _model.Username)" />
                            @if(!string.IsNullOrWhiteSpace(_usernameAvailabilityMessage))
                            {
                                <div class="@_usernameAvailabilityClass complete-profile-status-text">@_usernameAvailabilityMessage</div>
                            }
                        </div>

                        <div class="form-group">
                            <label for="firstname">First name</label>
                            <InputText id="firstname" @bind-Value="_model.Firstname" class="form-control" />
                            <ValidationMessage For="@(() => _model.Firstname)" />
                        </div>

                        <div class="form-group">
                            <label for="lastname">Last name</label>
                            <InputText id="lastname" @bind-Value="_model.Lastname" class="form-control" />
                            <ValidationMessage For="@(() => _model.Lastname)" />
                        </div>

                        <div class="form-group">
                            <label for="discordId">Discord ID</label>
                            <InputText id="discordId" @bind-Value="_model.DiscordId" class="form-control" />
                            <ValidationMessage For="@(() => _model.DiscordId)" />
                        </div>

                        <div class="form-group">
                            <label for="steamId">Steam ID</label>
                            <InputText id="steamId" @bind-Value="_model.SteamId" class="form-control" />
                            <ValidationMessage For="@(() => _model.SteamId)" />
                        </div>

                        <div class="form-group">
                            <label for="riotId">Riot ID</label>
                            <InputText id="riotId" @bind-Value="_model.RiotId" class="form-control" />
                            <ValidationMessage For="@(() => _model.RiotId)" />
                        </div>
                    </div>

                    <div class="form-actions-section">
                        <button type="submit" class="btn btn-primary" disabled="@_isSaving">Save profile</button>
                    </div>
                </EditForm>
            </section>

            <aside class="complete-profile-sidebar">
                <section class="brand-card complete-profile-side-card">
                    <span class="section-eyebrow">Why this matters</span>
                    <h2>What this profile unlocks</h2>
                    <ul class="complete-profile-points">
                        <li>Username checks before tournament registration.</li>
                        <li>Bracket, placement, and participant displays.</li>
                        <li>Linked Discord, Steam, or Riot identifiers when needed.</li>
                    </ul>
                </section>
            </aside>
        </div>
    </section>
}
