@page "/"
@using Mercurius.LAN.Web.Components.Shared
@using Mercurius.LAN.Web.Extensions
@rendermode InteractiveServer

<PageTitle>Mercurius LAN</PageTitle>

@if(_tournaments == null && _loadError is null)
{
    <LoadingScreen Message="Loading..." />
}
else if(_loadError is not null)
{
    <section class="brand-section">
        <div class="brand-card home-empty-state" role="alert">
            <h1>Unable to load tournament highlights</h1>
            <p>@_loadError</p>
            <button type="button" class="button-primary" @onclick="RetryLoadAsync">Try again</button>
        </div>
    </section>
}
else
{
    <section class="home-hero">
        @{
            string? primaryHeroImage = HeroTournaments.Count > 0 ? AssetUrlResolver.Resolve(Configuration, HeroTournaments[0].ImageUrl) : null;
            string? secondaryHeroImage = HeroTournaments.Count > 1 ? AssetUrlResolver.Resolve(Configuration, HeroTournaments[1].ImageUrl) : null;
            string? tertiaryHeroImage = HeroTournaments.Count > 2 ? AssetUrlResolver.Resolve(Configuration, HeroTournaments[2].ImageUrl) : null;
        }

        <div class="home-hero-shell">
            <div class="home-hero-media" aria-hidden="true">
                @if(primaryHeroImage is not null)
                {
                    <img src="@primaryHeroImage" alt="" class="home-hero-media-image home-hero-media-image--primary" />
                }

                @if(secondaryHeroImage is not null)
                {
                    <img src="@secondaryHeroImage" alt="" class="home-hero-media-image home-hero-media-image--secondary" />
                }

                @if(tertiaryHeroImage is not null)
                {
                    <img src="@tertiaryHeroImage" alt="" class="home-hero-media-image home-hero-media-image--tertiary" />
                }

                <div class="home-hero-media-glow home-hero-media-glow--green"></div>
                <div class="home-hero-media-glow home-hero-media-glow--violet"></div>
                <div class="home-hero-media-grid"></div>
            </div>

            <div class="home-hero-content">
                <img src="/img/lan_logo_wide_light.svg" alt="Mercurius LAN" class="home-hero-wordmark" />

                <h1 class="home-hero-title">The student LAN weekend with real atmosphere.</h1>

                <div class="home-hero-actions">
                    <a href="/info#tickets" class="button-primary">Get Your Tickets</a>
                    <a href="/info" class="button-secondary">Event Info</a>
                </div>

                <div class="home-hero-info-group">
                    <div class="home-hero-date-card">
                        <span class="home-hero-date-label">Event date</span>
                        <span class="home-hero-date-value">@EventWindow</span>
                    </div>

                    <div class="home-hero-detail-row">
                        <div class="home-hero-detail-card home-hero-location-card">
                            <span class="home-hero-detail-label">Location</span>
                            <span class="home-hero-detail-value home-hero-location-value">@HeroLocation</span>
                        </div>
                    </div>
                </div>

                <a href="@(_sponsors.Any() ? "#home-sponsors" : "#home-content")" class="home-hero-scroll-link" aria-label="Scroll to the rest of the home page">
                    <span class="home-hero-scroll-label">Explore the event</span>
                    <span class="home-hero-scroll-indicator" aria-hidden="true"></span>
                </a>
            </div>           
        </div>
    </section>

    <div id="home-content" class="home-flow">
        @if(_sponsors.Any())
        {
            <section id="home-sponsors" class="brand-section home-sponsors">
                <div class="home-sponsors-panel brand-panel-dark">
                    <div class="home-sponsors-header">                  
                        <span class="section-eyebrow">Our partners</span>
                        <a href="/sponsors" class="button-secondary home-sponsors-cta">View All Partners</a>
                    </div>

                <div class="home-sponsors-slider">
                    <SponsorScroller Sponsors="_sponsors" AriaLabel="Home page sponsor logos" />
                </div>
                </div>
            </section>
        }

        <section class="brand-section home-features">
            <article class="brand-card feature-card">
                <span class="brand-section-number">01</span>
                <h2>Tournaments</h2>
                <p>Compete across multiple tournaments, climb the bracket, and chase the weekend highlight.</p>
            </article>
            <article class="brand-card feature-card">
                <span class="brand-section-number">02</span>
                <h2>BYOC Setup</h2>
                <p>Bring your own gear and settle in for long sessions with friends, rivals, and new teammates.</p>
            </article>
            <article class="brand-card feature-card">
                <span class="brand-section-number">03</span>
                <h2>Community</h2>
                <p>Meet students who care about good tournaments, good setups, and a strong event atmosphere.</p>
            </article>
        </section>

        <section class="brand-section">
            <div class="home-section-header">
                <div>
                    <span class="section-eyebrow">Compete in your favorite tournaments</span>
                    <h2>Featured Tournaments</h2>
                </div>
                <a href="/tournaments" class="button-secondary">View All Tournaments</a>
            </div>

            <div class="home-tournament-grid">
                @if(FeaturedTournaments.Count == 0)
                {
                    <p class="home-empty-copy">No tournaments are currently published.</p>
                }
                @foreach(var tournament in FeaturedTournaments)
                {
                    var imageUrl = AssetUrlResolver.Resolve(Configuration, tournament.ImageUrl);
                    <article class="brand-card home-tournament-card" @onclick="() => NavigateToTournament(tournament.Id)">
                        <img src="@imageUrl" alt="@tournament.Name" class="home-tournament-image" />
                        <div class="home-tournament-body">
                            <div class="home-tournament-meta">
                                <h3>@tournament.Name</h3>
                                <span class="tournament-status @tournament.Status.GetStatusClass()">@tournament.Status.GetStatusLabel()</span>
                            </div>
                            <p>@tournament.BracketType.GetLabel() · @tournament.Format.GetLabel()</p>
                        </div>
                    </article>
                }
            </div>
        </section>

        <section id="schedule" class="brand-section">
            <div class="brand-card schedule-strip">
                <div>
                    <span class="section-eyebrow">Mark your calendar</span>
                    <h2>@EventWindow</h2>
                    <p>Official event window managed with the LAN party information.</p>
                </div>
                <div class="schedule-points">
                    <div>
                        <h3>Play</h3>
                        <p>Non-stop gaming sessions across the weekend.</p>
                    </div>
                    <div>
                        <h3>Compete</h3>
                        <p>Bracket-driven matches with data-backed registrations.</p>
                    </div>
                    <div>
                        <h3>Connect</h3>
                        <p>Find teammates, rivals, and new communities.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="tickets" class="brand-section home-callout-grid">
            <article class="brand-card home-callout">
                <span class="section-eyebrow">Tickets</span>
                <h2>Join the LAN</h2>
                <p>Compare visitor and gamer passes, then use the tournament list to explore competitions and registration options.</p>
                <a href="/info#tickets" class="button-primary">View Ticket Info</a>
            </article>

            <article id="contact" class="brand-card home-callout">
                <span class="section-eyebrow">Contact</span>
                <h2>Need more info?</h2>
                <p>Find the venue, packing guide, catering menu, and community links on the dedicated info page.</p>
                <a href="/info#contact-info" class="button-secondary">Contact Us</a>
            </article>
        </section>
    </div>
}
